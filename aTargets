<script>
(function(){
  var KEY = 'targets40-scores-v1';
  var TARGET = 95;
  var inputs = Array.prototype.slice.call(document.querySelectorAll('input.score, input[type=checkbox]'));
  var byId = {};
  inputs.forEach(function(el){ byId[el.id] = el; });
 
  function ceil1(x){ return Math.ceil(x * 10 - 1e-9) / 10; }
  function r1(x){ return (Math.round(x * 10) / 10).toFixed(1); }
  function r0(x){ return r1(x).replace(/\.0$/, ''); }
  function num(id){
    var el = byId[id];
    if (!el || el.value === '') { if (el) { el.classList.remove('invalid'); } return null; }
    var v = parseFloat(el.value), max = parseFloat(el.max);
    if (isNaN(v) || v < 0 || v > max) { el.classList.add('invalid'); return null; }
    el.classList.remove('invalid');
    return v;
  }
  function on(id){ return byId[id] ? byId[id].checked : false; }
  var PH = {
    'c-m1': ['Midterm 1', 'Midterm 1'], 'c-m2': ['Midterm 2', 'Midterm 2'], 'c-final': ['Final', 'the final'],
    'p-mid': ['Midterm 1', 'Midterm 1'], 'p-mid2': ['Midterm 2', 'Midterm 2'], 'p-final': ['Final', 'the final'],
    'm-int': ['Interview', 'the interview'], 'm-nos': ['Never on Sundays', 'the Never on Sundays paper'], 'm-zorba': ['Zorba', 'the Zorba paper'],
    'm-paper': ['Research paper', 'the research paper'], 'm-blog': ['Blog', 'the blog'],
    'y-quiz': ['Quiz 1', 'Quiz 1'], 'y-quiz2': ['Quiz 2', 'Quiz 2'], 'y-proj': ['Project', 'the project'], 'y-exam': ['Final', 'the final']
  };
  function nameOf(id){ return PH[id] ? PH[id][0] : byId[id].getAttribute('data-name'); }
  function phraseOf(id){ return PH[id] ? PH[id][1] : nameOf(id); }
  function listOf(ids){
    var p = ids.map(phraseOf);
    if (p.length === 1) { return p[0]; }
    return p.slice(0, -1).join(', ') + (p.length > 2 ? ',' : '') + ' and ' + p[p.length - 1];
  }
  function avg(a){ return a.reduce(function(s, x){ return s + x; }, 0) / a.length; }
 
  // Smallest even score x on every pending item that reaches the target.
  // Returns >100 if out of reach, <=0 if already covered.
  function solve(grade, vals, pending){
    function g(x){
      var v = Object.assign({}, vals);
      pending.forEach(function(id){ v[id] = x; });
      return grade(v);
    }
    if (g(100) < TARGET - 1e-9) { return 101; }
    if (g(0) >= TARGET - 1e-9) { return 0; }
    var lo = 0, hi = 100;
    for (var i = 0; i < 60; i++) { var mid = (lo + hi) / 2; if (g(mid) >= TARGET - 1e-9) { hi = mid; } else { lo = mid; } }
    return hi;
  }
  function fmtNeed(need){
    if (need > 100.0001) { return { text: 'Out of reach', cls: 'out' }; }
    if (need <= 0) { return { text: 'Covered', cls: 'ok' }; }
    return { text: ceil1(need).toFixed(1), cls: '' };
  }
  function setAim(id, need){
    var cell = document.getElementById('aim-' + id);
    if (!cell) { return; }
    cell.className = 'num target';
    if (need === 'done') { cell.textContent = 'Done'; cell.classList.add('done'); return; }
    if (typeof need === 'string') { cell.textContent = need; return; }
    var f = fmtNeed(need);
    cell.textContent = f.text;
    if (f.cls) { cell.classList.add(f.cls); }
  }
  function needPhrase(need, where){
    if (need > 100.0001) { return 'Even 100s on ' + where + ' wouldn’t reach 95.'; }
    if (need <= 0) { return 'You’ve already locked in a 95.'; }
    return 'You need about ' + ceil1(need).toFixed(1) + ' on ' + where + ' for a 95.';
  }
  function whereOf(pending){
    return (pending.length === 2 ? 'both ' : pending.length > 2 ? 'each of ' : '') + listOf(pending);
  }
 
  // Generic course runner
  function run(c){
    var vals = {}, pending = [];
    (c.assumed || []).forEach(function(a){ var v = num(a[0]); vals[a[0]] = v === null ? a[1] : v; if (a[2]) { setAim(a[0], v === null ? a[2] : 'done'); } });
    c.solveFor.forEach(function(id){ var v = num(id); vals[id] = v; if (v === null) { pending.push(id); } });
    var need = pending.length ? solve(c.grade, vals, pending) : null;
    c.project = function(x){ var v = Object.assign({}, vals); pending.forEach(function(id){ v[id] = x; }); return c.grade(v); };
    c.solveFor.forEach(function(id){ setAim(id, vals[id] === null ? need : 'done'); });
 
    var st = c.intro(vals) + ' ';
    if (pending.length) { st += needPhrase(need, whereOf(pending)); }
    else { st += 'Your projected grade is ' + r1(c.grade(vals)) + '.'; }
    if (c.outro) { st += c.outro(vals, need, pending); }
    document.getElementById(c.p + '-standing').textContent = st.trim();
 
    var out = document.getElementById(c.p + '-out'), text, cls = '', cap;
    if (!pending.length) {
      var g = c.grade(vals); text = r1(g);
      cap = g >= TARGET ? 'Projected course grade. That’s a 95 or better.' : 'Projected course grade, below 95.';
    } else if (need > 100.0001) { cls = 'no'; text = 'Out of reach'; cap = 'Even 100s on everything left would not get you to 95 with these scores.'; }
    else if (need <= 0) { cls = 'ok'; text = 'Already covered'; cap = 'You reach 95 even with zeros on what’s left.'; }
    else { text = ceil1(need).toFixed(1); cap = 'Score needed on ' + whereOf(pending) + ' to finish at 95.'; }
    out.innerHTML = '<span class="big ' + cls + '">' + text + '</span><span class="cap">' + cap + '</span>';
 
    // Scenarios for the next pending item
    var panel = document.getElementById(c.p + '-scen-panel');
    if (pending.length < 2) { panel.hidden = true; return; }
    panel.hidden = false;
    var next = pending[0], rest = pending.slice(1);
    document.getElementById(c.p + '-scen-title').textContent = 'What ' + phraseOf(next) + ' changes';
    document.getElementById(c.p + '-scen-h1').textContent = 'If ' + phraseOf(next) + ' is';
    document.getElementById(c.p + '-scen-h2').textContent = rest.length === 1 ? nameOf(rest[0]) + ' needed' : 'Each of the rest needs';
    var html = '';
    [100, 95, 90, 85, 80].forEach(function(s){
      var v = Object.assign({}, vals); v[next] = s;
      var f = fmtNeed(solve(c.grade, v, rest));
      html += '<tr><td>' + s + '</td><td' + (f.cls === 'out' ? ' class="out"' : '') + '>' + f.text + '</td></tr>';
    });
    document.getElementById(c.p + '-scen').innerHTML = html;
  }
 
  var hwIds = [1,2,3,4,5,6,7,8,9].map(function(i){ return 'c-hw' + i; });
  var courses = [
    { p: 'c',
      assumed: hwIds.map(function(id){ return [id, 100, '100']; }),
      solveFor: ['c-m1', 'c-m2', 'c-final'],
      grade: function(v){
        var hw = avg(hwIds.map(function(id){ return v[id]; }));
        var a = v['c-m1'], b = v['c-m2'], f = v['c-final'];
        var hi = Math.max(a, b), lo = Math.min(a, b);
        return 0.17 * hw + 0.25 * hi + 0.25 * Math.max(lo, f) + 0.33 * f;
      },
      intro: function(v){
        var known = hwIds.map(num).filter(function(x){ return x !== null; });
        var w = 0, s = 0;
        if (known.length) { w += 0.17; s += 0.17 * avg(known); }
        [['c-m1', 0.25], ['c-m2', 0.25], ['c-final', 0.33]].forEach(function(e){ if (v[e[0]] !== null) { w += e[1]; s += e[1] * v[e[0]]; } });
        return w ? 'Graded so far you’re at about ' + r1(s / w) + '%.' : '';
      },
      outro: function(v){
        var lo = Math.min(v['c-m1'] === null ? 101 : v['c-m1'], v['c-m2'] === null ? 101 : v['c-m2']);
        return lo <= 100 ? ' If your final beats your lower midterm (' + r0(lo) + ' right now), it replaces it, so the final can count for 58%.' : '';
      } },
    { p: 'p',
      assumed: [['p-hw', 95], ['p-quiz', 100], ['p-lab', 95]],
      solveFor: ['p-mid', 'p-mid2', 'p-final'],
      grade: function(v){
        var q = on('p-cap') ? Math.min(v['p-quiz'], 100) : v['p-quiz'];
        return 0.10 * v['p-hw'] + 0.20 * q + 0.20 * v['p-lab'] + 0.15 * v['p-mid'] + 0.15 * v['p-mid2'] + 0.20 * v['p-final'];
      },
      intro: function(v){
        var q = v['p-quiz'];
        return 'Your homework average is about ' + r0(v['p-hw']) + ', quizzes ' + r0(q) + (on('p-cap') && q > 100 ? ' (counted as 100)' : '') + ', and lab ' + (num('p-lab') === null ? '95 assumed' : r0(v['p-lab'])) + '.';
      },
      outro: function(v, need){
        return (need > 100.0001 && on('p-cap') && v['p-quiz'] > 100) ? ' Unchecking the quiz cap shows the optimistic case.' : '';
      } },
    { p: 'm',
      solveFor: ['m-int', 'm-nos', 'm-zorba', 'm-paper', 'm-blog'],
      grade: function(v){ return 0.2 * (v['m-int'] + v['m-nos'] + v['m-zorba'] + v['m-paper'] + v['m-blog']); },
      intro: function(v){
        var k = ['m-int', 'm-nos', 'm-zorba', 'm-paper', 'm-blog'].map(function(id){ return v[id]; }).filter(function(x){ return x !== null; });
        return 'Five graded pieces count 20% each.' + (k.length ? (k.length === 1 ? ' Your graded piece scored ' : ' Your ' + k.length + ' graded pieces average ') + r0(avg(k)) + '.' : '');
      } },
    { p: 'y',
      solveFor: ['y-quiz', 'y-quiz2', 'y-proj', 'y-exam'],
      grade: function(v){ return 0.30 * (v['y-quiz'] + v['y-quiz2']) / 2 + 0.40 * v['y-proj'] + 0.30 * v['y-exam']; },
      intro: function(v){
        var q = [v['y-quiz'], v['y-quiz2']].filter(function(x){ return x !== null; });
        return q.length ? 'Your quiz set average is ' + r0(avg(q)) + ' so far.' : '';
      },
      outro: function(v, need, pending){ return pending.indexOf('y-proj') > -1 ? ' The project is worth the most per point, so it’s the best lever.' : ''; } }
  ];
 
  // Timeline
  function pad(n){ return (n < 10 ? '0' : '') + n; }
  var now = new Date();
  var today = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());
  var anchors = { chem: '#chem', phys: '#phys', music: '#music', py: '#py' };
  function timeline(){
    document.querySelectorAll('.timeline li').forEach(function(li){
      var d = li.getAttribute('data-date'), past = d < today;
      var aim = li.querySelector('.aim'), sid = li.getAttribute('data-score');
      li.classList.toggle('today', d === today);
      li.classList.toggle('past', past);
      if (!sid) { li.hidden = past; return; }
      var v = num(sid);
      li.hidden = past && v !== null;
      aim.className = 'aim';
      if (v !== null) { aim.classList.add('scored'); aim.innerHTML = r0(v) + '<small>your score</small>'; }
      else if (past) { aim.innerHTML = '<a href="' + anchors[li.getAttribute('data-course')] + '">Add your score</a>'; }
      else {
        var cell = document.getElementById('aim-' + sid), t = cell ? cell.textContent : '';
        if (t === 'Out of reach') { aim.classList.add('out'); }
        aim.textContent = t;
      }
    });
  }
 
  var SCALE = [[95, 'A', 4.0], [90, 'A−', 3.67], [85, 'B+', 3.33], [80, 'B', 3.0], [75, 'B−', 2.67], [70, 'C+', 2.33], [65, 'C', 2.0], [-1, 'F', 0]];
  function letter(pct){
    var p = on('g-round') ? Math.round(pct) : pct;
    for (var i = 0; i < SCALE.length; i++) { if (p >= SCALE[i][0] - 1e-9) { return SCALE[i]; } }
    return SCALE[SCALE.length - 1];
  }
  function gpa(){
    var assume = num('g-assume'); if (assume === null) { assume = 90; }
    var byP = {}; courses.forEach(function(c){ byP[c.p] = c; });
    var lab = num('p-lab');
    var rows = [['chem', byP.c.project(assume)], ['phys', byP.p.project(assume)], ['lab', lab === null ? 95 : lab], ['music', byP.m.project(assume)], ['py', byP.y.project(assume)]];
    var pts = 0, cr = 0, below = [];
    rows.forEach(function(r){
      var k = r[0];
      byId['g-pct-' + k].placeholder = r1(r[1]);
      var typed = num('g-pct-' + k), pct = typed === null ? r[1] : typed;
      var credits = num('g-cr-' + k); if (credits === null) { credits = 0; }
      var L = letter(pct);
      var lc = document.getElementById('g-let-' + k);
      lc.innerHTML = L[1] + '<span class="note">' + L[2].toFixed(2) + ' points</span>'; lc.className = 'num letter' + (L[1] === 'A' ? ' a' : '');
      pts += L[2] * credits; cr += credits;
      if (L[1] !== 'A' && credits > 0) { below.push(k); }
    });
    var g = cr ? pts / cr : 0;
    var names = { chem: 'chemistry', phys: 'physics', lab: 'the physics lab', music: 'Greek music', py: 'Python' };
    document.getElementById('g-out').innerHTML = '<span class="big' + (g >= 3.995 ? '' : '') + '">' + g.toFixed(2) + '</span><span class="cap">Semester GPA over ' + r0(cr) + ' credits.</span>';
    var st = 'With ' + r0(assume) + ' on everything still ungraded, your semester GPA would be ' + g.toFixed(2) + '. ';
    if (!below.length) { st += 'That’s an A in every course.'; }
    else { st += 'Short of an A: ' + below.map(function(k){ return names[k]; }).join(', ') + '. Each A− instead of an A costs about ' + (cr ? (0.33 * 4 / cr).toFixed(2) : '0') + ' for a 4-credit course.'; }
    document.getElementById('g-standing').textContent = st;
    var prev = num('g-prev'), prevcr = num('g-prevcr'), cum = document.getElementById('g-cum');
    if (prev !== null && prevcr) {
      var cg = (prev * prevcr + pts) / (prevcr + cr);
      cum.innerHTML = '<span class="big">' + cg.toFixed(2) + '</span><span class="cap">Cumulative GPA over ' + r0(prevcr + cr) + ' credits.</span>';
    } else {
      cum.innerHTML = '<span class="cap">Enter your GPA and credits so far to see your cumulative GPA.</span>';
    }
  }
 
  function recalc(){ courses.forEach(run); timeline(); gpa(); }
 
  // Storage
  var statusEl = document.getElementById('status');
  function save(){
    var data = {};
    try { data = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { data = {}; }
    inputs.forEach(function(el){ data[el.id] = el.type === 'checkbox' ? (el.checked ? '1' : '0') : el.value; });
    try { localStorage.setItem(KEY, JSON.stringify(data)); statusEl.textContent = 'Saved in this browser.'; }
    catch (e) { statusEl.textContent = 'Couldn’t save here, so scores will reset when you close the page.'; }
  }
  function applyDefaults(){
    inputs.forEach(function(el){
      var d = el.getAttribute('data-default');
      if (el.type === 'checkbox') { el.checked = d === '1'; } else { el.value = d === null ? '' : d; }
    });
  }
  function load(){
    applyDefaults();
    var data = null;
    try { data = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { data = null; }
    if (!data) { return; }
    inputs.forEach(function(el){
      if (!(el.id in data)) { return; }
      if (el.type === 'checkbox') { el.checked = data[el.id] === '1'; } else { el.value = data[el.id]; }
    });
  }
  inputs.forEach(function(el){
    el.addEventListener('input', function(){ recalc(); save(); });
    el.addEventListener('change', function(){ recalc(); save(); });
  });
  document.getElementById('reset').addEventListener('click', function(){
    if (!window.confirm('Clear the scores you’ve entered and go back to the Nov 3 grades?')) { return; }
    try { localStorage.removeItem(KEY); } catch (e) {}
    applyDefaults(); recalc();
    statusEl.textContent = 'Reset to the Nov 3 grades.';
  });
 
  load();
  recalc();
})();
</script>
</body>
</html>
 
