<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Targets for a 4.0</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;700&display=swap">
<style>
:root{
  color-scheme: light;
  --bg:#F4F5F8; --card:#FFFFFF; --ink:#151A2D; --muted:#586078; --line:#DCE0EA; --soft:#ECEEF4;
  --chem:#0B7A66; --chem-bg:#E2F3EE;
  --phys:#3E3FC4; --phys-bg:#E8E8FA;
  --music:#B02F7A; --music-bg:#F9E6F1;
  --py:#9A5B00; --py-bg:#FAEFD9;
  --bad:#B3261E; --good:#17723A;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme: dark;
    --bg:#0E1120; --card:#171B2E; --ink:#EEF0F8; --muted:#A3AAC2; --line:#2A3050; --soft:#1F2440;
    --chem:#4FD1B6; --chem-bg:#12332D;
    --phys:#A3A4FF; --phys-bg:#25264F;
    --music:#F28CC4; --music-bg:#40203A;
    --py:#F0B454; --py-bg:#3D2E10;
    --bad:#FF8A80; --good:#7EDC9E;
  }
}
:root[data-theme="dark"]{
  color-scheme: dark;
  --bg:#0E1120; --card:#171B2E; --ink:#EEF0F8; --muted:#A3AAC2; --line:#2A3050; --soft:#1F2440;
  --chem:#4FD1B6; --chem-bg:#12332D;
  --phys:#A3A4FF; --phys-bg:#25264F;
  --music:#F28CC4; --music-bg:#40203A;
  --py:#F0B454; --py-bg:#3D2E10;
  --bad:#FF8A80; --good:#7EDC9E;
}
html{scroll-padding-top:env(safe-area-inset-top,0px);}
*,*::before,*::after{box-sizing:border-box;}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Schibsted Grotesk",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-size:16px;line-height:1.55;font-variant-numeric:tabular-nums;}
.wrap{max-width:1040px;margin:0 auto;padding:40px 20px 72px;}
h1{font-size:clamp(34px,6vw,56px);line-height:1.04;margin:0 0 12px;font-weight:700;letter-spacing:-0.02em;}
h2{font-size:26px;line-height:1.15;margin:0;font-weight:700;letter-spacing:-0.01em;}
h3{font-size:17px;margin:0 0 10px;font-weight:500;}
p{margin:0;}
.lede{max-width:62ch;color:var(--muted);font-size:18px;}
.jump{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 0;padding:0;list-style:none;}
.jump a{display:inline-block;padding:7px 14px;border-radius:999px;text-decoration:none;font-weight:500;font-size:14px;border:1px solid var(--line);color:var(--ink);background:var(--card);}
.jump a:hover{border-color:var(--ink);}
a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--phys);outline-offset:2px;}
.block{margin-top:44px;}
.sectionhead{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 16px;margin-bottom:14px;}
.sub{color:var(--muted);font-size:15px;}
.timeline{list-style:none;margin:0;padding:0;background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;}
.timeline li{display:grid;grid-template-columns:96px 1fr auto;gap:6px 16px;align-items:center;padding:14px 18px;border-bottom:1px solid var(--line);}
.timeline li:last-child{border-bottom:0;}
.timeline li.today{background:var(--soft);}
.date b{display:block;font-weight:700;font-size:15px;line-height:1.2;}
.date span{font-size:13px;color:var(--muted);}
.what{min-width:0;}
.what strong{font-weight:500;display:block;}
.what small{color:var(--muted);font-size:13.5px;display:block;}
.chip{display:inline-block;font-size:12.5px;font-weight:500;padding:1px 9px;border-radius:999px;margin-right:8px;vertical-align:1px;}
.c-chem{color:var(--chem);background:var(--chem-bg);}
.c-phys{color:var(--phys);background:var(--phys-bg);}
.c-music{color:var(--music);background:var(--music-bg);}
.c-py{color:var(--py);background:var(--py-bg);}
.aim{font-size:30px;font-weight:700;line-height:1;text-align:right;letter-spacing:-0.02em;}
.aim small{display:block;font-size:12px;font-weight:400;color:var(--muted);letter-spacing:0;margin-top:3px;}
.aim.word{font-size:18px;font-weight:500;}
.course{margin-top:56px;padding-top:22px;border-top:4px solid var(--accent);--accent:var(--chem);--accent-bg:var(--chem-bg);}
.course.phys{--accent:var(--phys);--accent-bg:var(--phys-bg);}
.course.music{--accent:var(--music);--accent-bg:var(--music-bg);}
.course.py{--accent:var(--py);--accent-bg:var(--py-bg);}
.course h2{color:var(--accent);}
.standing{margin:8px 0 18px;max-width:68ch;font-size:17px;}
.grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:20px;align-items:start;}
.tablebox{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow-x:auto;}
table{width:100%;border-collapse:collapse;font-size:15px;min-width:520px;}
th{text-align:left;font-weight:500;font-size:13.5px;color:var(--muted);padding:12px 16px 8px;border-bottom:1px solid var(--line);}
td{padding:11px 16px;border-bottom:1px solid var(--line);vertical-align:top;}
tr:last-child td{border-bottom:0;}
td.num,th.num{text-align:right;white-space:nowrap;}
.tablebox td:first-child{white-space:nowrap;}
td .note{display:block;color:var(--muted);font-size:13.5px;}
td.target{font-weight:700;font-size:18px;color:var(--accent);}
.panel{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px;}
.panel + .panel{margin-top:16px;}
.field{display:block;margin-bottom:12px;}
.field span{display:block;font-size:14px;color:var(--muted);margin-bottom:4px;}
input[type=number],select{width:100%;font:inherit;font-size:16px;padding:9px 11px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--ink);}
.check{display:flex;align-items:center;gap:8px;margin-bottom:12px;font-size:15px;}
.check input{width:18px;height:18px;accent-color:var(--accent);}
.result{display:block;margin-top:6px;padding:14px;border-radius:10px;background:var(--accent-bg);}
.result .big{display:block;font-size:40px;font-weight:700;line-height:1;color:var(--accent);letter-spacing:-0.02em;}
.result .big.no{color:var(--bad);font-size:26px;}
.result .big.ok{color:var(--good);font-size:26px;}
.result .cap{display:block;margin-top:6px;font-size:14px;color:var(--ink);}
.err{color:var(--bad);font-size:14px;margin-top:4px;min-height:1px;}
.mini{width:100%;min-width:0;font-size:15px;}
.mini th,.mini td{padding:8px 4px;border-bottom:1px solid var(--line);}
.mini td:last-child,.mini th:last-child{text-align:right;}
.mini tr:last-child td{border-bottom:0;}
.mini .out{color:var(--bad);font-weight:500;}
.fine{margin-top:14px;font-size:14px;color:var(--muted);max-width:76ch;}
footer{margin-top:64px;padding-top:20px;border-top:1px solid var(--line);color:var(--muted);font-size:14px;max-width:76ch;}
@media (max-width:860px){
  .grid{grid-template-columns:1fr;}
}
@media (max-width:560px){
  .wrap{padding:28px 14px 56px;}
  .timeline li{grid-template-columns:70px 1fr auto;gap:4px 10px;padding:12px 12px;}
  .aim{font-size:24px;}
}
 
.toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;margin-top:20px;}
.btn{font:inherit;font-size:14px;font-weight:500;padding:8px 14px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer;}
.btn:hover{border-color:var(--ink);}
.btn:focus-visible{outline:3px solid var(--phys);outline-offset:2px;}
.status{font-size:14px;color:var(--muted);}
td input.score{width:84px;padding:6px 8px;font-size:15px;text-align:right;}
td input.score::placeholder{color:var(--muted);opacity:.8;}
input.invalid{border-color:var(--bad);box-shadow:0 0 0 1px var(--bad);}
td.target.done{color:var(--muted);font-weight:500;font-size:15px;}
td.target.out{color:var(--bad);font-size:15px;}
td.target.ok{color:var(--good);font-size:15px;}
.timeline li.past .what,.timeline li.past .date{opacity:.6;}
.aim.scored{color:var(--good);}
.aim a{font-size:14px;font-weight:500;color:var(--accent-link,var(--phys));}
.aim.out{color:var(--bad);font-size:18px;}
.hint{font-size:14px;color:var(--muted);margin:0 0 12px;}
[hidden]{display:none !important;}
.course.gpa{--accent:var(--ink);--accent-bg:var(--soft);}
#gpa table{min-width:440px;}
#gpa td{padding:11px 10px;}
#gpa td input.score{width:68px;}
td.letter{font-weight:700;font-size:18px;line-height:1.2;}
td.letter .note{font-weight:400;}
td.letter.a{color:var(--good);}
.scale{display:flex;flex-wrap:wrap;gap:6px 14px;margin:14px 0 0;padding:0;list-style:none;font-size:14px;color:var(--muted);}
.scale b{color:var(--ink);font-weight:500;}
@media (prefers-reduced-motion:no-preference){ .result .big{transition:color .2s;} }
</style>
</head>
